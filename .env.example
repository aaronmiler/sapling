# Copy to .env for local overrides (dotenv-rails loads it in dev/test).
# Config lives in env vars; reach for encrypted credentials only when something needs encrypting.

# Development / test — all optional, defaults match the README's Postgres one-liner
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres
# PORT=3000

# Production — required (set in your deploy's env file, not here)
# SECRET_KEY_BASE=   # generate with: bin/rails secret
# DATABASE_URL=postgres://user:password@host:5432/app_production
